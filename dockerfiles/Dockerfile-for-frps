FROM node:22 AS web-builder

COPY web/package.json /web/package.json
COPY web/package-lock.json /web/package-lock.json
COPY web/shared/package.json /web/shared/package.json
COPY web/frpc/package.json /web/frpc/package.json
COPY web/frps/package.json /web/frps/package.json
WORKDIR /web
RUN npm ci
COPY web/shared/ /web/shared/
COPY web/frps/ /web/frps/
RUN npm run build --workspace frps

FROM golang:1.25 AS building

WORKDIR /building
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-builder /web/frps/dist ./web/frps/dist

RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -tags frps -o /usr/local/bin/frps ./cmd/frps

FROM alpine:3

RUN apk add --no-cache tzdata
RUN addgroup -S -g 10001 frp \
    && adduser -S -D -H -u 10001 -G frp frp \
    && mkdir -p /var/lib/frp \
    && chown frp:frp /var/lib/frp

COPY --from=building /usr/local/bin/frps /usr/local/bin/frps

USER frp
WORKDIR /var/lib/frp
ENTRYPOINT ["/usr/local/bin/frps"]
